# Database (required)
# Use file:local.db for local development or a libSQL/Turso URL in production.
DATABASE_CONNECTION_URL=file:local.db

# Required only when DATABASE_CONNECTION_URL points to a remote database.
DATABASE_AUTH_TOKEN=

# Resend API key used to send account and reservation emails (required).
MAILER=re_replace_with_your_resend_api_key

# Secret used to authenticate /api/internal/cleanup (required in production).
CRON_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Secret used to hash rate-limit identifiers (required, minimum 32 characters).
# This must be different from CRON_SECRET.
RATE_LIMIT_HASH_SECRET=replace_with_another_random_secret_at_least_32_characters

# Optional: Pino log level. Defaults to debug locally and info in production.
# LOG_LEVEL=debug

# Optional: URL targeted by Playwright. Defaults to http://localhost:5173.
# BASE_URL=http://localhost:5173
