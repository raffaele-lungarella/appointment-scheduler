{
  "name": "emis-barber-shop",
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "analyze": "vite build --mode analyze",
    "audit": "pnpm audit --audit-level high",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "vite dev",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "release": "pnpm build",
    "release:migrate": "pnpm db:migrate",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm exec playwright test",
    "test:codegen": "pnpm exec playwright codegen http://localhost:5173",
    "test:report": "pnpm exec playwright show-report"
  },
  "dependencies": {
    "@libsql/client": "^0.15.4",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/table-core": "^8.21.3",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.2",
    "pino": "^9.6.0",
    "resend": "^4.5.1",
    "typebox": "1.2.16"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "1.3.0",
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-vercel": "^6.0.0",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.15.15",
    "bits-ui": "2.16.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "formsnap": "2.0.1",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "mode-watcher": "^1.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "svelte": "5.56.8",
    "svelte-check": "^4.1.7",
    "svelte-sonner": "^1.1.0",
    "sveltekit-superforms": "2.30.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@10.34.5"
}
